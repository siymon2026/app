# =========================================================
# SIYMON Platform — Environment Configuration Example
# Copy to .env and fill in production secrets. Never commit .env!
# =========================================================

NODE_ENV=development
PORT=3000

# Security & Auth (Required in production)
JWT_SECRET=replace_with_a_strong_32_byte_random_hex_secret
JWT_ADMIN_EXPIRES_IN=2h
JWT_CUSTOMER_EXPIRES_IN=30d
JWT_DRIVER_EXPIRES_IN=7d
JWT_RESTAURANT_EXPIRES_IN=7d
JWT_RESTAURANT_USER_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_PASSWORD=

# SMS / OTP Provider Configuration (Optional external provider; falls back to queued/sandbox log in dev)
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SIYMON
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5

# Maps, Geocoding & Road Routing
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODE_CONTACT=support@siymon.ma
ROUTING_URL=https://router.project-osrm.org
ORS_API_KEY=
DISPATCH_H3_RES=8

# Payment Provider Webhook Verification
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Web Push Notifications (Generate with: npm run webpush:vapid)
WEBPUSH_SUBJECT=mailto:admin@siymon.ma
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# Optional OAuth Providers
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Optional PostgreSQL / Prisma
DATABASE_URL=
REQUIRE_DATABASE_URL=0
HEALTHCHECK_DB=0
